{
  "name": "morning-call",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, voice-led morning bio-optimization check-in.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server/index.mjs",
    "start": "node src/server/index.mjs",
